  "about": {
    "pageTitle": "文档校对工作台",
    "subtitle": "跑在本机的长文档校对与改写工作台",
    "tabs": {
      "overview": "概览",
      "guide": "使用指南",
      "data": "数据与隐私",
      "license": "开源许可"
    },
    "overview": {
      "title": "这是什么",
      "desc": "一套跑在本机的文档校对工作台。把 Word 稿件放进来，用本地或自建模型找出错别字、标点、语病和行文问题，逐条确认后导出干净的成品——稿件内容不出这台机器。",
      "capabilities": "能做什么",
      "cap1": "错别字、标点、语法、一致性检查，逐条给出修改建议和理由",
      "cap2": "全文润色与降低 AI 痕迹改写，按自然段并行处理长稿",
      "cap3": "本地知识库：导入 PDF / Word / TXT 作为参考，让校对有据可依",
      "cap4": "格式克隆：从模板文档提取样式，一键套用到目标文档",
      "cap5": "侧栏工作区：自动收录处理过的文档，点一下就能接着改",
      "cap6": "历史记录：每次校对都可回溯、对比和恢复",
      "noticeTitle": "使用前提",
      "notice": "校对质量取决于所选模型。建议先在「功能设置」里配好本地 Ollama 或自建 API，校对结果务必人工复核后再定稿。"
    },
    "guide": {
      "title": "四步走完一份稿子",
      "step1Title": "1 · 打开文档",
      "step1": "在右侧预览区点「选择文件」挑一份 .docx；也可以直接点侧栏里的历史文档，接着上次的进度继续。",
      "step2Title": "2 · 选模型和模式",
      "step2": "顶部「执行模型」里选择已保存的模型；按稿件长度选逐句、逐段或全文校对。",
      "step3Title": "3 · 开始校对",
      "step3": "点「开始校正」，结果逐条列出，每条都有原文、建议和理由。点列表项可在右侧预览里定位到对应位置。",
      "step4Title": "4 · 应用并导出",
      "step4": "逐条应用、按类别批量应用，或用「忽略」跳过；确认无误后点「导出结果」生成新文件。",
      "sidebarTitle": "左侧栏工作区",
      "sidebarDesc": "左边栏会自动收集你打开过的文档，按所在文件夹分组。点一下就回到那份文档和它上次的校对结果。鼠标悬停时行尾会出现「⋯」，可以定位文件、打开成果或移出工作区。",
      "tipsTitle": "几个建议",
      "tip1": "长文档先在 Word 里设好标题级别，分段识别会更准。",
      "tip2": "一万字以内的稿子可以直接用全文校对。",
      "tip3": "格式克隆不迁移段落内部的零散格式，导出后仍需人工过一遍。"
    },
    "data": {
      "title": "数据都在这台机器上",
